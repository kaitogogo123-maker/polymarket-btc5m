{
  "name": "polymarket-btc5m",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/state", "/push", "/live"] },
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "StateHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StateHub"] }]
}
